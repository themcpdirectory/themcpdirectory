{
  "name": "@themcpdirectory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx dist/index.js",
    "lint": "eslint .",
    "pretest": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "pretest:integration": "pnpm build",
    "test:integration": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@themcpdirectory/config": "workspace:*",
    "hono": "4.13.5",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@themcpdirectory/eslint-config": "workspace:*",
    "@themcpdirectory/typescript-config": "workspace:*",
    "@themcpdirectory/vitest-config": "workspace:*",
    "@types/node": "^20",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
