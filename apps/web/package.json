{
  "name": "@themcpdirectory/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port ${WEB_PORT:-3000}",
    "build": "next build --webpack",
    "start": "next start --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --passWithNoTests",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@themcpdirectory/config": "workspace:*",
    "@themcpdirectory/db": "workspace:*",
    "@themcpdirectory/domain": "workspace:*",
    "@themcpdirectory/security": "workspace:*",
    "@themcpdirectory/ui": "workspace:*",
    "next": "16.3.4",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@themcpdirectory/eslint-config": "workspace:*",
    "@themcpdirectory/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
