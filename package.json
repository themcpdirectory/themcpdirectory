{
  "name": "themcpdirectory",
  "version": "0.1.0",
  "private": true,
  "description": "The open directory for the MCP ecosystem.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.10 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo build",
    "db:generate": "pnpm --filter @themcpdirectory/db db:generate",
    "db:migrate": "pnpm --filter @themcpdirectory/db db:migrate",
    "db:seed": "pnpm --filter @themcpdirectory/db-seed db:seed",
    "dev": "turbo dev --concurrency=100%",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "release:dependency-audit": "pnpm --filter @themcpdirectory/release-tools exec tsx src/verify-dependency-audit.ts",
    "release:database": "pnpm --filter @themcpdirectory/release-tools exec tsx src/verify-database-release.ts",
    "release:lockfile-integrity": "pnpm --filter @themcpdirectory/release-tools exec tsx src/verify-lockfile-integrity.ts",
    "release:secret-scan": "pnpm --filter @themcpdirectory/release-tools exec tsx src/verify-secret-scanning.ts",
    "test": "turbo test",
    "test:cli": "pnpm --filter @themcpdirectory/cli test",
    "test:e2e": "pnpm --filter @themcpdirectory/web test:e2e",
    "test:integration": "turbo test:integration",
    "test:lighthouse": "pnpm --filter @themcpdirectory/release-tools exec tsx src/run-lighthouse.ts",
    "typecheck": "turbo typecheck",
    "web:security-release": "WEB_E2E_MODE=production pnpm --filter @themcpdirectory/web exec playwright test e2e/security.release.spec.ts"
  },
  "devDependencies": {
    "@themcpdirectory/cli": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
